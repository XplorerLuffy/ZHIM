# Supabase Edge Function secrets
# Set these with: supabase secrets set KEY=value
# or create supabase/.env.local (never commit this file)

OPENAI_API_KEY=sk-...
SPOONACULAR_API_KEY=...
EXERCISEDB_API_KEY=...

# These are set automatically by Supabase — do not set manually
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
