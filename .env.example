# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://zhim:zhim_secret@localhost:5432/zhim_db
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_minimum_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── SMS / OTP ─────────────────────────────────────────────────────
TASHICELL_API_URL=https://api.tashicell.com/sms
TASHICELL_API_KEY=
BT_SMS_API_URL=https://api.bhutantelecom.bt/sms
BT_SMS_API_KEY=
TWILIO_ACCOUNT_SID=                # fallback
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments ──────────────────────────────────────────────────────
MBOB_API_URL=https://api.mbob.bt
MBOB_MERCHANT_ID=
MBOB_API_KEY=
MBOB_SECRET=
MYPAY_API_URL=https://api.mypay.bt
MYPAY_MERCHANT_ID=
MYPAY_SECRET=
BNB_PAY_API_URL=https://api.bnbpay.bt
BNB_PAY_MERCHANT_ID=
BNB_PAY_SECRET=
RAZORPAY_KEY_ID=                   # INR card fallback
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# ─── Maps ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Search ────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME

# ─── Storage ───────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zhim-media
R2_PUBLIC_URL=https://media.zhim.bt

# ─── Firebase ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Loyverse ──────────────────────────────────────────────────────
LOYVERSE_API_TOKEN=
LOYVERSE_SYNC_INTERVAL_MINUTES=15

# ─── Feature flags ─────────────────────────────────────────────────
ENABLE_SCHEDULED_ORDERS=true
ENABLE_GROUP_ORDERING=false        # V2
ENABLE_ZHIM_MART=false             # V2
SURGE_PRICING_ENABLED=true
