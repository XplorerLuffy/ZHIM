# Wellexus mobile app environment variables
# Copy to .env and fill in values from your Supabase project dashboard.

# Supabase project — required
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API keys (OpenAI, Spoonacular, ExerciseDB) are now handled server-side
# via Supabase Edge Functions — set them with:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set SPOONACULAR_API_KEY=...
#   supabase secrets set EXERCISEDB_API_KEY=...
# See supabase/.env.example for the full list.
